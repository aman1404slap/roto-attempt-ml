ENV=local
DJANGO_DEBUG=true
SECRET_KEY=randomString

# Matches docker-compose.yml, which maps Postgres to 5433 on the host.
DATABASE_URL=postgres://roto:roto@localhost:5433/roto

# aws
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=access_key_id
AWS_SECRET_ACCESS_KEY=secret_access_key
AWS_SESSION_TOKEN=session_token

# our bucket: datasets and runs, read/write
AWS_DEFAULT_BUCKET=

# the archive, other account, read only. Only the dataset build reads it.
SOURCE_S3_BUCKET=production-citadel
SOURCE_S3_PREFIX=

# local | staging. Stamped on every checkpoint; a local run can never be quoted as a result.
ROTO_ENVIRONMENT=local

# local runs the training command as a subprocess here; ecs launches a GPU task.
RUN_EXECUTOR=local

# where datasets are synced and runs are written before being synced back
SCRATCH_DIR=

DEFAULT_DATASET_VERSION=v003

# ecs (staging only -- devops provides these)
ECS_RUN_TASK_CLUSTER_NAME=
ECS_RUN_TASK_CONTAINER_NAME=roto
ECS_RUN_TASK_DEFINITION=
ECS_RUN_TASK_SUBNET_IDS=
ECS_RUN_TASK_SECURITY_GROUP_IDS=
ECS_TASK_LOG_GROUP=

# this service can start GPU instances, so the key is required in every environment
ROTO_APP_TASK_API_KEY=rotoapptaskapikey

# URL prefix for ALB routing
URL_PREFIX=

SENTRY_DSN=
